{% comment %}
  Tisso Grid — "in the wild" shop-the-look section (built from scratch).
  Six product blocks are selectable from the customizer. Hotspots open a
  product popup with dynamically rendered variants and a working Add to Cart.
{% endcomment %}

{{ 'tisso-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tisso-grid.js' | asset_url }}" defer></script>

{%- liquid
  assign bonus_product = section.settings.soft_winter_jacket
  assign bonus_variant_id = ''

  if bonus_product != blank
    assign bonus_variant_id = bonus_product.selected_or_first_available_variant.id
  else
    assign bonus_product = all_products['soft-winter-jacket']
    if bonus_product != blank
      assign bonus_variant_id = bonus_product.selected_or_first_available_variant.id
    endif
  endif
-%}

<section
  id="TissoGrid-{{ section.id }}"
  class="tisso-grid"
  data-tisso-grid
  data-bonus-variant-id="{{ bonus_variant_id }}"
  data-bonus-product-title="Soft Winter Jacket"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="tisso-grid__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <ul class="tisso-grid__list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign product = block.settings.product
        assign image = block.settings.image
        if image == blank and product != blank
          assign image = product.featured_image
        endif

        assign hotspot_x = block.settings.hotspot_x | default: 70
        assign hotspot_y = block.settings.hotspot_y | default: 40
      -%}

      <li
        class="tisso-grid__item"
        {{ block.shopify_attributes }}
        data-tisso-product-item
      >
        {%- if image != blank -%}
          {%- liquid
            assign image_alt = image.alt
            if image_alt == blank and product != blank
              assign image_alt = product.title
            endif
            if image_alt == blank
              assign image_alt = section.settings.heading
            endif
          -%}
          {{
            image
            | image_url: width: 1200
            | image_tag:
              class: 'tisso-grid__image',
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(max-width: 749px) 50vw, 33vw',
              alt: image_alt
          }}
        {%- else -%}
          <div class="tisso-grid__placeholder">
            {%- if product != blank -%}
              {{ product.title | escape }}
            {%- else -%}
              Select a product
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if product != blank -%}
          <button
            type="button"
            class="tisso-grid__hotspot"
            style="left: {{ hotspot_x }}%; top: {{ hotspot_y }}%;"
            data-tisso-hotspot
            aria-label="Quick view {{ product.title | escape }}"
          >
            <span aria-hidden="true">+</span>
          </button>

          {%- comment -%}
            Embed a compact product payload so the popup can render variants
            dynamically without additional network requests.
          {%- endcomment -%}
          <script type="application/json" data-tisso-product-json>
            {
              "id": {{ product.id | json }},
              "title": {{ product.title | json }},
              "description": {{ product.description | strip_html | truncate: 220 | json }},
              "price": {{ product.price | json }},
              "featured_image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 400 | json }}{% else %}""{% endif %},
              "options": [
                {%- for option in product.options_with_values -%}
                  {
                    "name": {{ option.name | json }},
                    "values": {{ option.values | json }}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ],
              "variants": [
                {%- for variant in product.variants -%}
                  {
                    "id": {{ variant.id | json }},
                    "title": {{ variant.title | json }},
                    "available": {{ variant.available | json }},
                    "price": {{ variant.price | json }},
                    "option1": {{ variant.option1 | json }},
                    "option2": {{ variant.option2 | json }},
                    "option3": {{ variant.option3 | json }}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            }
          </script>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>

  <!-- Product quick-view popup -->
  <div
    class="tisso-popup"
    data-tisso-popup
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="TissoPopupTitle-{{ section.id }}"
  >
    <button type="button" class="tisso-popup__overlay" data-tisso-popup-close aria-label="Close dialog"></button>

    <div class="tisso-popup__dialog" data-tisso-popup-dialog>
      <button type="button" class="tisso-popup__close" data-tisso-popup-close aria-label="Close">
        ×
      </button>

      <div class="tisso-popup__header">
        <img class="tisso-popup__thumb" data-tisso-popup-thumb src="" alt="" width="104" height="104" hidden>
        <div class="tisso-popup__meta">
          <h3 class="tisso-popup__title" id="TissoPopupTitle-{{ section.id }}" data-tisso-popup-title></h3>
          <p class="tisso-popup__price" data-tisso-popup-price></p>
          <p class="tisso-popup__description" data-tisso-popup-description></p>
        </div>
      </div>

      <div class="tisso-popup__options" data-tisso-popup-options></div>

      <p class="tisso-popup__error" data-tisso-popup-error role="alert" aria-live="polite"></p>

      <button type="button" class="tisso-btn tisso-btn--black tisso-popup__add" data-tisso-popup-add disabled>
        <span class="tisso-btn__label">ADD TO CART</span>
        <span class="tisso-btn__arrow" aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Grid",
  "tag": "div",
  "class": "section-tisso-grid",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "product",
      "id": "soft_winter_jacket",
      "label": "Soft Winter Jacket (auto-add product)",
      "info": "Automatically added to cart when a product with Black + Medium variants is added."
    }
  ],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lifestyle image",
          "info": "Optional. Falls back to the product featured image."
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Hotspot horizontal position",
          "default": 70
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Hotspot vertical position",
          "default": 40
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid",
      "blocks": [
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" }
      ]
    }
  ]
}
{% endschema %}
