{% comment %}
  Tisso Banner — Gift Guide hero section (built from scratch).
  All red-boxed copy from the design is editable via the section schema.
{% endcomment %}

{{ 'tisso-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tisso-banner.js' | asset_url }}" defer></script>

{%- liquid
  assign logo_text = section.settings.logo_text
  assign announcement = section.settings.announcement_text
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign shop_label = section.settings.shop_button_label
  assign shop_link = section.settings.shop_button_link
  assign choose_label = section.settings.choose_button_label
  assign choose_link = section.settings.choose_button_link
  assign bottom_text = section.settings.bottom_bar_text
-%}

<section
  id="TissoBanner-{{ section.id }}"
  class="tisso-banner"
  data-tisso-banner
  style="
    --tisso-yellow: {{ section.settings.choose_button_color }};
    --tisso-bar: {{ section.settings.bottom_bar_color }};
    --tisso-muted: {{ section.settings.background_color }};
  "
>
  <div class="tisso-banner__top">
    <button
      type="button"
      class="tisso-banner__menu-toggle"
      data-tisso-menu-toggle
      aria-expanded="false"
      aria-controls="TissoBannerNav-{{ section.id }}"
      aria-label="{{ section.settings.menu_aria_label | escape }}"
    >
      <span></span>
    </button>

    <p class="tisso-banner__logo">
      {%- if section.settings.logo_link != blank -%}
        <a href="{{ section.settings.logo_link }}">{{ logo_text | escape }}</a>
      {%- else -%}
        {{ logo_text | escape }}
      {%- endif -%}
    </p>

    {%- if announcement != blank -%}
      <p class="tisso-banner__announcement">{{ announcement | escape }}</p>
    {%- endif -%}

    {%- if choose_label != blank -%}
      <a class="tisso-btn tisso-btn--yellow" href="{{ choose_link | default: '#' }}">
        <span class="tisso-btn__label">{{ choose_label | escape }}</span>
        <span class="tisso-btn__arrow" aria-hidden="true">→</span>
      </a>
    {%- endif -%}

    <nav
      id="TissoBannerNav-{{ section.id }}"
      class="tisso-banner__mobile-nav"
      data-tisso-mobile-nav
      aria-label="{{ section.settings.menu_aria_label | escape }}"
    >
      {%- if section.settings.mobile_menu != blank -%}
        {%- for link in section.settings.mobile_menu.links -%}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endfor -%}
      {%- else -%}
        {%- if choose_link != blank -%}
          <a href="{{ choose_link }}">{{ choose_label | default: 'Choose Gift' | escape }}</a>
        {%- endif -%}
        {%- if shop_link != blank -%}
          <a href="{{ shop_link }}">{{ shop_label | default: 'Shop Now' | escape }}</a>
        {%- endif -%}
      {%- endif -%}
    </nav>
  </div>

  <div class="tisso-banner__hero">
    <div class="tisso-banner__media" aria-hidden="true">
      {%- if section.settings.background_image != blank -%}
        {{
          section.settings.background_image
          | image_url: width: 3840
          | image_tag:
            loading: 'eager',
            widths: '750, 1100, 1500, 2000, 3000, 3840',
            sizes: '100vw',
            alt: ''
        }}
      {%- else -%}
        <img
          src="{{ 'tisso-banner-bg.svg' | asset_url }}"
          alt=""
          width="1600"
          height="900"
          loading="eager"
        >
      {%- endif -%}
    </div>

    <div class="tisso-banner__content">
      {%- if heading != blank -%}
        <h2 class="tisso-banner__heading">{{ heading | escape }}</h2>
      {%- endif -%}

      {%- if text != blank -%}
        {%- comment -%}
          Mobile design shows a shorter supporting line; keep the first sentence
          visible and tuck the rest behind a helper class.
        {%- endcomment -%}
        {%- assign text_parts = text | split: '. ' -%}
        <p class="tisso-banner__text">
          {{ text_parts.first | escape }}{% if text_parts.size > 1 %}.{% endif %}
          {%- if text_parts.size > 1 -%}
            <span class="tisso-banner__text-extra">
              {{ text_parts | slice: 1, text_parts.size | join: '. ' | escape }}
            </span>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if shop_label != blank -%}
        <a class="tisso-btn tisso-btn--black tisso-banner__cta" href="{{ shop_link | default: '#' }}">
          <span class="tisso-btn__label">{{ shop_label | escape }}</span>
          <span class="tisso-btn__arrow" aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if bottom_text != blank or section.settings.bottom_bar_text_mobile != blank -%}
    <div class="tisso-banner__bottom">
      {%- if bottom_text != blank -%}
        <p class="tisso-banner__bottom-text tisso-banner__bottom-text--desktop">{{ bottom_text | escape }}</p>
      {%- endif -%}
      <p class="tisso-banner__bottom-text tisso-banner__bottom-text--mobile">
        {{ section.settings.bottom_bar_text_mobile | default: bottom_text | escape }}
      </p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Banner",
  "tag": "div",
  "class": "section-tisso-banner",
  "settings": [
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "choose_button_label",
      "label": "Choose Gift button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "choose_button_link",
      "label": "Choose Gift button link"
    },
    {
      "type": "color",
      "id": "choose_button_color",
      "label": "Choose Gift button color",
      "default": "#FFE600"
    },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "Mobile menu"
    },
    {
      "type": "text",
      "id": "menu_aria_label",
      "label": "Mobile menu accessibility label",
      "default": "Menu"
    },
    {
      "type": "header",
      "content": "Hero content"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background illustration"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F2F2F2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "shop_button_label",
      "label": "Shop Now button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "shop_button_link",
      "label": "Shop Now button link"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "bottom_bar_text",
      "label": "Bottom bar text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "text",
      "id": "bottom_bar_text_mobile",
      "label": "Bottom bar text (mobile)",
      "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR",
      "info": "Optional. Falls back to the desktop bottom bar text when empty."
    },
    {
      "type": "color",
      "id": "bottom_bar_color",
      "label": "Bottom bar color",
      "default": "#ECECEC"
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}
